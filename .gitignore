```
# WordPress specific ignores
wp-content/cache/
wp-content/uploads/
wp-config.php
*.sql

# Dependencies
node_modules/
vendor/

# Build artifacts

build/
*.min.css
*.min.js
*.zip
*.map

# Environment
.env
.env.local
*.env.*

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python (if any Python files detected)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp
```

# Distribution artifacts are kept under dist/ (versioned, not ignored)
!dist/
!dist/**
